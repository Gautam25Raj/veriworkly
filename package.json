{
  "name": "veriworkly",
  "version": "3.21.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/VeriWorkly/veriworkly.git"
  },
  "workspaces": [
    "apps/site",
    "apps/studio",
    "apps/portfolio",
    "apps/blog-platform",
    "apps/docs-platform",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @veriworkly/site",
    "dev:site": "npm run dev -w @veriworkly/site -- -p 3000",
    "dev:studio": "npm run dev -w @veriworkly/studio -- -p 3001",
    "dev:docs": "npm run dev -w @veriworkly/docs-platform -- -p 3002",
    "dev:blog": "npm run dev -w @veriworkly/blog-platform -- -p 3003",
    "dev:portfolio": "npm run dev -w @veriworkly/portfolio -- -p 3004",
    "dev:server": "npm run dev -w @veriworkly/server",
    "dev:all": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:site": "npm run build -w @veriworkly/site",
    "build:studio": "npm run build -w @veriworkly/studio",
    "build:blog": "npm run build -w @veriworkly/blog-platform",
    "build:docs": "npm run build -w @veriworkly/docs-platform",
    "build:portfolio": "npm run build -w @veriworkly/portfolio",
    "build:server": "npm run build -w @veriworkly/server",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "generate:api": "npm run generate:api -w @veriworkly/docs-platform",
    "db:push": "npm run db:push -w @veriworkly/server",
    "db:migrate": "npm run db:migrate -w @veriworkly/server",
    "db:generate": "npm run db:generate -w @veriworkly/server",
    "db:studio": "npm run db:studio -w @veriworkly/server"
  },
  "devDependencies": {
    "@hono/node-server": "2.0.12",
    "@types/node": "^25",
    "eslint": "^9",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "typescript": "^6"
  },
  "overrides": {
    "postcss": "8.5.24",
    "next": {
      "sharp": "0.35.3"
    },
    "prisma": {
      "@prisma/dev": {
        "@hono/node-server": "2.0.12",
        "valibot": "1.4.2"
      }
    },
    "@hono/node-server": "2.0.12",
    "hono": "4.12.32",
    "fast-uri": "3.1.4",
    "body-parser": "1.20.6",
    "better-sqlite3": "12.11.1",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": {
      "js-yaml": "4.3.0",
      "fumadocs-core": "16.13.0"
    },
    "fumadocs-openapi": {
      "js-yaml": "4.3.0"
    },
    "eslint": {
      "js-yaml": "4.3.0"
    },
    "fumadocs-ui": "16.13.0",
    "@fumadocs/api-docs": {
      "fumadocs-core": "16.13.0",
      "fumadocs-ui": "16.13.0"
    }
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.1",
    "@rolldown/binding-linux-x64-gnu": "^1.1.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.0",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
}
