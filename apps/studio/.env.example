# =========================================================
# 🎨 Frontend & API Configuration
# =========================================================

SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Public API URL (used in browser/client-side code)
# Must start with NEXT_PUBLIC_ for frontend exposure
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api/v1

# Internal API URL
BACKEND_INTERNAL_URL=http://localhost:8080/api/v1


# =========================================================
# 👤 Admin Configuration
# =========================================================

# Should match the ADMIN_EMAIL in .env.docker and Backend .env for consistency across environments
# Admin email for system access / notifications
ADMIN_EMAIL=

# =========================================================
# Growth programs
# =========================================================

# Affiliate and campus ambassador programs. Unset or empty means "on outside production, off in
# production". Set to true/false to force. The server reads its own copy of these flags.
# AFFILIATE_PROGRAM_ENABLED=
# AMBASSADOR_PROGRAM_ENABLED=
