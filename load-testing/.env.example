# =========================================================
# Load testing target configuration
# Copy this file to load-testing/.env and fill in per environment.
# Values here are read by scenarios/*.yml via `environments.*.target`
# and by run.mjs.
# =========================================================

# --- Local dev (matches root package.json dev:* ports) ---
LOCAL_SERVER_URL=http://localhost:8080
LOCAL_SITE_URL=http://localhost:3000
LOCAL_STUDIO_URL=http://localhost:3001
LOCAL_DOCS_URL=http://localhost:3002
LOCAL_BLOG_URL=http://localhost:3003
LOCAL_PORTFOLIO_URL=http://localhost:3004

# --- Staging (fill in before running `--env staging`) ---
STAGING_SERVER_URL=
STAGING_SITE_URL=
STAGING_STUDIO_URL=
STAGING_DOCS_URL=
STAGING_BLOG_URL=
STAGING_PORTFOLIO_URL=

# --- Production (fill in before running `--env production`) ---
# Only run production load tests with the team's sign-off. See README "Testing against prod".
PRODUCTION_SERVER_URL=
PRODUCTION_SITE_URL=
PRODUCTION_STUDIO_URL=
PRODUCTION_DOCS_URL=
PRODUCTION_BLOG_URL=
PRODUCTION_PORTFOLIO_URL=

# A real, published portfolio username to hit for portfolio-page/API scenarios.
# Falls back to a placeholder that will 404 (still useful for error-path/rate testing)
# if left blank.
PORTFOLIO_TEST_USERNAME=

# A real, published blog post slug to hit for the blog-platform "Post detail"
# scenario. Falls back to a slug that 404s if left blank.
BLOG_TEST_SLUG=

# Optional: a valid session cookie or API key for authenticated scenarios.
# Leave blank to skip authenticated requests (default scenarios are all
# unauthenticated/public routes so this is not required to get started).
AUTH_API_KEY=
AUTH_COOKIE=

# --- Server scenarios (see README "Server API scenarios") ---
# TARGET is used with `--environment target`; ORIGIN is sent on every server request.
TARGET=
ORIGIN=http://localhost:3001
SESSION_COOKIE=
ADMIN_SESSION_COOKIE=
API_KEY=
SHARE_USERNAME=
SHARE_SLUG=
